# Dockerfile.kthena-tokenizer-e2e builds the tokenizer image for E2E tests.
# Uses gcr.io/distroless/static:nonroot instead of the full vLLM CPU image so
# that the E2E suite can run in CI environments without pulling the multi-GB
# vllm/vllm-openai-cpu base. The stub renderer (kthena-tokenizer-stub) is
# included so VLLM_RENDER_COMMAND can be overridden without a real vllm install.
FROM golang:1.26.4 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY cmd/ cmd/
COPY pkg/ pkg/
COPY client-go/ client-go/

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o kthena-tokenizer cmd/kthena-tokenizer/main.go
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o kthena-tokenizer-stub cmd/kthena-tokenizer-stub/main.go

FROM gcr.io/distroless/static:nonroot

COPY --from=builder /workspace/kthena-tokenizer /usr/local/bin/kthena-tokenizer
COPY --from=builder /workspace/kthena-tokenizer-stub /usr/local/bin/kthena-tokenizer-stub

ENTRYPOINT ["/usr/local/bin/kthena-tokenizer"]
